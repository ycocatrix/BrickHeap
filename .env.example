# Copy to `.env` (git-ignored) and fill in your own values.
# Variables prefixed EXPO_PUBLIC_ are embedded in the app bundle: they are PUBLIC.
# Never put a secret / service_role key in an EXPO_PUBLIC_ variable.

# --- Supabase (https://supabase.com — Free Tier) ---------------------------
# Project Settings > API > Project URL
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings > API keys > publishable key ("default", starts with sb_publishable_).
# Safe in the client ONLY because Row Level Security is enabled on every table (see supabase/migrations/).
# The legacy "anon" key (EXPO_PUBLIC_SUPABASE_ANON_KEY) is still read as a fallback, but the
# `catalog-proxy` Edge Function rejects it: use the publishable key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Rebrickable (https://rebrickable.com/api/ — free) ---------------------
# Account > Settings > API. Used server-side through the Supabase Edge Function
# `catalog-proxy`, so it is NOT exposed to the app. Set it with:
#   supabase secrets set REBRICKABLE_API_KEY=...
# Kept here only as documentation / for local function runs (supabase/.env).
REBRICKABLE_API_KEY=your-rebrickable-key

# --- Vision engine ----------------------------------------------------------
# Brickognize public API (no key needed today). Override to self-host.
EXPO_PUBLIC_BRICKOGNIZE_URL=https://api.brickognize.com

# --- Optional: test account for manual / integration tests (never bundled) ---
# Use single quotes if the password contains $ or other special characters.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
